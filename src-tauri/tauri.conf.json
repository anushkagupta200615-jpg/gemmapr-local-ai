{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Letshack Bouncer",
  "version": "0.2.0",
  "identifier": "dev.letshack.bouncer",
  "build": {
    "frontendDist": "../app/web"
  },
  "app": {
    "windows": [
      {
        "label": "hud",
        "title": "Letshack Bouncer - HUD",
        "url": "http://127.0.0.1:8765/",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      },
      {
        "label": "gate",
        "title": "THE GATE",
        "url": "http://127.0.0.1:8765/gate",
        "width": 720,
        "height": 560,
        "alwaysOnTop": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
